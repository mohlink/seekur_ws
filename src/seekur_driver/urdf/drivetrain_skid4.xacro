<?xml version="1.0"?>
<!-- =====================================================================
     Train de roulement SKID-STEER 4 ROUES (drivetrain:=skid4)
     Inclus par seekur_jr_variants.urdf.xacro, qui fournit les proprietes
     (wheelbase, wheel_separation, ...), les macros d'inertie et drive_wheel.

     Copie de la cinematique du VRAI SeekurJR (2026-10-08) : 4 roues
     motrices aux positions reelles [DS] (x = +/- wheelbase/2 = +/- 0.2125,
     y = +/- wheel_separation/2), aucune roulette. Les 2 roues d'un meme cote
     tournent a la meme vitesse. Pour tourner, les pneus glissent
     lateralement : c'est le principe du skid-steer.

     Noms des joints : base_left/right_wheel_joint = roues AVANT (noms
     communs a toutes les variantes : DiffDrive les met en premier pour
     l'odometrie, les roues visuelles les suivent par mimic) ;
     base_rear_left/right_wheel_joint = roues ARRIERE, ajoutees au plugin
     DiffDrive via le bloc extra_drive_joints.

     Pas d'hyperstatisme a corriger : sur sol plat les 4 pneus portent ;
     sur sol irregulier une roue peut decoller, comme sur le vrai robot
     (pneus 16 x 6.50-8, pas de suspension).

     LIMITES CONNUES [SIM] :
       - Le plugin DiffDrive calcule vitesses de roues ET odometrie avec
         wheel_separation = 0.663 (cinematique differentielle). En
         skid-steer, le glissement lateral fait que le robot tourne MOINS
         vite que commande et que l'odometrie Gazebo SURESTIME la rotation.
         Le vrai firmware corrige le cap avec son gyro ; ici l'EKF (IMU sim)
         le fait. A mesurer : rapport lacet IMU / lacet commande en
         rotation sur place.
       - Frottements : longitudinal 1.0, lateral 0.6 (wheel_mu_lateral).
         Plus le lateral est faible, plus le robot tourne facilement (et
         moins il tient en devers). Valeur de depart, non mesuree.
     ===================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="wheel_mu_long" value="1.0" />     <!-- dans le sens de roulement -->
    <xacro:property name="wheel_mu_lateral" value="0.6" />  <!-- le long de l'axe de roue [SIM] -->

    <!-- 4 roues motrices aux positions reelles -->
    <xacro:drive_wheel side="right"      x="${wheelbase / 2.0}"  y="${-wheel_separation / 2.0}" />
    <xacro:drive_wheel side="left"       x="${wheelbase / 2.0}"  y="${wheel_separation / 2.0}" />
    <xacro:drive_wheel side="rear_right" x="${-wheelbase / 2.0}" y="${-wheel_separation / 2.0}" />
    <xacro:drive_wheel side="rear_left"  x="${-wheelbase / 2.0}" y="${wheel_separation / 2.0}" />

    <!-- Frottement anisotrope : mu1 s'applique le long de fdir1 (lateral),
         mu2 dans le sens de roulement.
         ATTENTION au repere : DART lit fdir1 dans le repere de la FORME de
         collision (ShapeNode, dart/constraint/ContactSurface.cpp), pas du
         link. Le cylindre de roue est tourne de pi/2 autour de X : l'axe de
         roue y est Z. Donc fdir1 = 0 0 1.
         Bug du 2026-10-08 : avec 0 1 0 (rayon de la roue, qui tourne avec
         elle), le lateral recevait souvent mu = 1.0 et le longitudinal 0.6 :
         couple moteur ~153 N.m < resistance ~164 N.m, le robot ne tournait
         pas. Avec 0 0 1 : ~256 N.m moteur contre ~98 N.m de resistance. -->
    <xacro:macro name="wheel_friction" params="side">
        <gazebo reference="${side}_wheel_link">
            <mu1>${wheel_mu_lateral}</mu1>
            <mu2>${wheel_mu_long}</mu2>
            <fdir1>0 0 1</fdir1>
        </gazebo>
    </xacro:macro>
    <xacro:wheel_friction side="right" />
    <xacro:wheel_friction side="left" />
    <xacro:wheel_friction side="rear_right" />
    <xacro:wheel_friction side="rear_left" />

    <!-- ================================================================
         GLISSEMENT DES PNEUS : systeme WheelSlip de gz-sim (2026-10-08)

         Probleme : DART traite le frottement comme une BOITE (2 directions
         independantes, axe de roue / sens de roulement, chacune plafonnee
         a +/- mu N ; dart/constraint/ContactConstraint.cpp), pas un cercle.
         En rotation sur place les 4 pneus glissent lateralement, chaque
         force laterale est saturee a mu N quelle que soit la vitesse de
         glissement : avant et arriere se compensent et le moment resistant
         est le meme pour TOUT pivot entre les deux essieux (equilibre
         neutre). Un petit biais (CG 9 mm devant) pousse le pivot jusqu'au
         bord : l'essieu AVANT. Mesures 2026-10-08 : pivot a x = +0.20 /
         +0.21 m, insensible a la repartition de charge (elasticite des pneus
         essayee puis retiree), au sens de rotation, a l'anisotropie du
         frottement et a l'ordre de declaration.

         Correction : WheelSlip rend la force laterale PROPORTIONNELLE au
         glissement (comme la rigidite de derive d'un vrai pneu) :
           force / charge = taux de glissement / slip_compliance
         jusqu'au plafond mu. Les pneus se partagent alors le glissement et
         le pivot revient au centre.

         Valeurs [SIM] :
           lateral 1.5 : en rotation sur place, taux de glissement lateral
             ~ (wheelbase/2) / (wheel_separation/2) = 0.64 -> force/charge
             0.43 < mu 0.6 : on reste dans la zone proportionnelle (au-dela,
             saturation et equilibre neutre a nouveau).
           longitudinal 0 : pas de glissement dans le sens de roulement, la
             rotation reelle egale la commande (le firmware du vrai robot
             regule le lacet avec son gyro).
         La compliance est multipliee par la vitesse de roue : a l'arret,
         aucun glissement (pas de derive sur une pente).
         Prerequis WheelSlip respectes : fdir1 parallele a l'axe de roue,
         une seule collision et un seul joint parent par roue. -->
    <xacro:property name="slip_compliance_lateral" value="1.5" />
    <xacro:property name="slip_compliance_longitudinal" value="0.0" />
    <!-- charge statique estimee par roue : chassis + capteurs (~1.5 kg) + 4 roues -->
    <xacro:property name="wheel_normal_force" value="${(base_mass + 1.5 + 4.0 * wheel_mass) * 9.81 / 4.0}" />

    <xacro:macro name="slip_wheel" params="side">
        <wheel link_name="${side}_wheel_link">
            <slip_compliance_lateral>${slip_compliance_lateral}</slip_compliance_lateral>
            <slip_compliance_longitudinal>${slip_compliance_longitudinal}</slip_compliance_longitudinal>
            <wheel_normal_force>${wheel_normal_force}</wheel_normal_force>
            <wheel_radius>${wheel_radius}</wheel_radius>
        </wheel>
    </xacro:macro>

    <gazebo>
        <plugin filename="gz-sim-wheel-slip-system" name="gz::sim::systems::WheelSlip">
            <xacro:slip_wheel side="right" />
            <xacro:slip_wheel side="left" />
            <xacro:slip_wheel side="rear_right" />
            <xacro:slip_wheel side="rear_left" />
        </plugin>
    </gazebo>

    <!-- Roues arriere ajoutees au plugin DiffDrive commun -->
    <xacro:property name="extra_drive_joints">
        <left_joint>base_rear_left_wheel_joint</left_joint>
        <right_joint>base_rear_right_wheel_joint</right_joint>
    </xacro:property>

    <!-- JointStatePublisher : UNE SEULE declaration (par variante). -->
    <gazebo>
        <plugin filename="libgz-sim-joint-state-publisher-system.so" name="gz::sim::systems::JointStatePublisher">
            <joint_name>base_left_wheel_joint</joint_name>
            <joint_name>base_right_wheel_joint</joint_name>
            <joint_name>base_rear_left_wheel_joint</joint_name>
            <joint_name>base_rear_right_wheel_joint</joint_name>
        </plugin>
    </gazebo>

</robot>
