<?xml version="1.0"?>
<robot name="seekur_jr" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Argument pour la couleur -->
    <xacro:arg name="robot_color" default="Grey"/>
    <xacro:property name="robot_color" value="$(arg robot_color)"/>

    <!-- =======================================================
         Proprietes SeekurJR - Datasheet officiel Adept Rev B
         (SeekurJr-Datasheet-RevB.pdf, 2011, Adept MobileRobots)
         ======================================================= -->
    <xacro:property name="base_length" value="1.051" />      <!-- 1051 mm datasheet -->
    <xacro:property name="base_width" value="0.494" />       <!-- 494 mm chassis hors roues -->
    <xacro:property name="base_height" value="0.425" />      <!-- 425 mm hauteur chassis -->
    <xacro:property name="wheel_radius" value="0.203" />     <!-- 16" pneumatique = 406 mm diam -->
    <xacro:property name="wheel_length" value="0.10" />      <!-- largeur pneu approx 10 cm -->
    <xacro:property name="wheel_separation" value="0.68" /> <!-- ESTIME : largeur_totale (663) - largeur_pneu (100). A MESURER AU LAB. -->

    <!-- Masses (datasheet : robot complet 77 kg) -->
    <xacro:property name="base_mass" value="60.0" />         <!-- chassis + electronique -->
    <xacro:property name="wheel_mass" value="8.0" />         <!-- 16" pneumatique ~8 kg piece -->
    <xacro:property name="caster_mass" value="0.5" />        <!-- non present sur vrai SeekurJR, garde pour stabilite Gazebo -->

    <!-- Couleurs -->
    <material name="blue"><color rgba="0 0 0.8 1" /></material>
    <material name="grey"><color rgba="0.5 0.5 0.5 1" /></material>
    <material name="white"><color rgba="1 1 1 1" /></material>
    <material name="black"><color rgba="0.2 0.2 0.2 1"/></material>
    <material name="red"><color rgba="0.8 0 0 1"/></material>

    <material name="robot_material">
        <color rgba="0.5 0.5 0.5 1" />
    </material>

    <!-- Macros d'inertie -->
    <xacro:macro name="box_inertia" params="m x y z o_xyz o_rpy">
        <inertial>
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <mass value="${m}" />
            <inertia ixx="${(m/12) * (y*y + z*z)}" ixy="0.0" ixz="0.0"
                     iyy="${(m/12) * (x*x + z*z)}" iyz="0.0"
                     izz="${(m/12) * (x*x + y*y)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r l o_xyz o_rpy">
        <inertial>
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <mass value="${m}" />
            <inertia ixx="${(m/12) * (3*r*r + l*l)}" ixy="0.0" ixz="0.0"
                     iyy="${(m/12) * (3*r*r + l*l)}" iyz="0.0"
                     izz="${(m/2) * r*r}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="sphere_inertia" params="m r o_xyz o_rpy">
        <inertial>
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <mass value="${m}" />
            <inertia ixx="${(2/5) * m * r*r}" ixy="0.0" ixz="0.0"
                     iyy="${(2/5) * m * r*r}" iyz="0.0"
                     izz="${(2/5) * m * r*r}" />
        </inertial>
    </xacro:macro>

    <!-- Links -->
    <link name="base_footprint" />

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
            <material name="robot_material"/>
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
        </collision>
        <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}" 
                          o_xyz="0 0 ${base_height / 2.0}" o_rpy="0 0 0" />
    </link>

    <link name="right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
        </collision>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_length}" 
                               o_xyz="0 0 0" o_rpy="${pi / 2.0} 0 0" />
    </link>

    <link name="left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
        </collision>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_length}" 
                               o_xyz="0 0 0" o_rpy="${pi / 2.0} 0 0" />
    </link>

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${wheel_radius / 2.0}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius / 2.0}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:sphere_inertia m="${caster_mass}" r="${wheel_radius / 2.0}" 
                             o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <!-- LiDAR Link -->
    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.07" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.07" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:cylinder_inertia m="1.0" r="0.05" l="0.07" 
                               o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <!-- IMU Link : centre du robot (bonne pratique fusion : proche du
         centre de rotation, minimise les accelerations parasites en rotation).
         Petit box symbolique, inertie negligeable mais non nulle (exigence Gazebo). -->
    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.03 0.03 0.02" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="red" />
        </visual>
        <xacro:box_inertia m="0.05" x="0.03" y="0.03" z="0.02"
                          o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <!-- ================================================================
         Camera RealSense D455 : montee sur mat au-dessus du chassis.
         Convention frames RealSense/ROS :
           - camera_link          : convention robot (X vers l'avant)
           - camera_optical_frame : convention optique (Z vers la scene,
                                    X droite, Y bas) - c'est ce frame_id
                                    que RTAB-Map, YOLO ROS, RViz attendent
                                    dans le header des images.
         Le sensor Gazebo est declare sur camera_link (regarde vers +X du
         link, donc vers l'avant du robot). Le gz_frame_id force le frame
         optique dans les messages ROS -> memes conventions que le vrai
         driver realsense2_camera.
         ================================================================ -->
    <link name="camera_link">
        <visual>
            <!-- D455 : 124 x 26 x 29 mm approximatif (bandeau caviar) -->
            <geometry>
                <box size="0.026 0.124 0.029" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="black" />
        </visual>
        <xacro:box_inertia m="0.1" x="0.026" y="0.124" z="0.029"
                          o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <!-- Frame optique : rotation ROS -> optique. Convention standard :
         RPY = (-pi/2, 0, -pi/2) fait que Z_optique aligne avec X_link,
         X_optique aligne avec -Y_link, Y_optique aligne avec -Z_link.
         C'est LA convention utilisee par tous les drivers de camera ROS. -->
    <link name="camera_optical_frame" />

    <!-- Joints -->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel_link" />
        <origin xyz="${-base_length / 4.0} ${-(base_width + wheel_length) / 2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel_link" />
        <origin xyz="${-base_length / 4.0} ${(base_width + wheel_length) / 2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <!-- IMU monte au CENTRE geometrique du chassis, a mi-hauteur.
         Centre de rotation du robot -> minimise les artefacts d'acceleration
         centripete quand le robot tourne. base_link est au sol via base_joint,
         donc z = base_height/2 place l'IMU a mi-hauteur du chassis. -->
    <joint name="imu_joint" type="fixed">
        <parent link="base_link" />
        <child link="imu_link" />
        <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
    </joint>

    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_link" />
        <origin xyz="${base_length / 3.0} 0 ${-wheel_radius / 2.0}" rpy="0 0 0" />
    </joint>

    <joint name="laser_joint" type="fixed">
        <parent link="base_link" />
        <child link="laser_frame" />
        <!-- LiDAR monte a l'AVANT en saillie, centre optique a mi-hauteur
            chassis (photo robot UQAT 2026-08). x=0.55 (devant le chassis),
            z=0.10 relatif a base_link (=0.30 m du sol). A affiner par
            mesure physique precise au lab. -->
        <origin xyz="0.55 0 0.10" rpy="0 0 0" />
    </joint>

    <!-- Camera sur mat : legerement devant le centre du chassis, ~60 cm
         au-dessus de base_link (~80 cm du sol total). Position ESTIMEE,
         a mesurer au lab. Le mat lui-meme n'est pas modelise visuellement
         (detail cosmetique) - on modelise juste la position de la camera
         qui compte pour la simulation. -->
    <joint name="camera_joint" type="fixed">
        <parent link="base_link" />
        <child link="camera_link" />
        <origin xyz="0.3 0 0.6" rpy="0 0 0" />
    </joint>

    <!-- Joint optique : rotation qui aligne le repere optique standard
         (Z vers la scene) avec le repere robot (X vers la scene). -->
    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link" />
        <child link="camera_optical_frame" />
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
    </joint>

    <gazebo>
        <plugin filename="libgz-sim-diff-drive-system.so" name="gz::sim::systems::DiffDrive">
            <left_joint>base_left_wheel_joint</left_joint>
            <right_joint>base_right_wheel_joint</right_joint>
            <wheel_separation>0.68</wheel_separation>      <!-- MAJ Rev B -->
            <wheel_radius>0.203</wheel_radius>              <!-- MAJ Rev B -->

            <topic>cmd_vel</topic>
            <odom_topic>odom</odom_topic>
            <tf_topic>tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>  <!-- CHANGEMENT ICI -->
            <publish_odom>true</publish_odom>
            <publish_odom_tf>false</publish_odom_tf>
            <!-- IMPORTANT : false. C'est robot_state_publisher qui doit
                 produire les TF des roues à partir de /joint_states.
                 Si les deux publient, RViz2 reçoit des TF en double
                 (avertissements TF_REPEATED_DATA + affichage instable). -->
            <publish_wheel_tf>false</publish_wheel_tf>
        </plugin>
    </gazebo>

    <!-- ==================================================================
         Plugin JointStatePublisher : UNE SEULE déclaration.
         C'est lui qui produit l'état (position/vitesse) des roues côté
         Gazebo. Ce flux doit ensuite être ponté vers ROS2 (/joint_states)
         par ros_gz_bridge, sinon RViz2 affiche des roues figées.
         ================================================================== -->
    <gazebo>
        <plugin filename="libgz-sim-joint-state-publisher-system.so" name="gz::sim::systems::JointStatePublisher">
            <joint_name>base_left_wheel_joint</joint_name>
            <joint_name>base_right_wheel_joint</joint_name>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
    </gazebo>

    <!-- Systeme IMU : indispensable pour que le capteur type "imu" produise
         des donnees. Distinct de gz-sim-sensors-system (qui gere lidar/camera).
         Sans ce systeme, le <sensor type="imu"> reste muet. -->
    <gazebo>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
        </plugin>
    </gazebo>

    <!-- Plugin LiDAR -->
    <gazebo reference="laser_frame">
        <sensor name="laser_scanner" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <topic>scan</topic>
            <gz_frame_id>laser_frame</gz_frame_id> 
            <update_rate>25</update_rate>   <!-- 10 -> 25 (LMS111 standard) -->
            <ray>
                <scan>
                    <horizontal>
                        <samples>541</samples>  <!-- 540 -> 541 (270° / 0.5° + 1) -->
                        <resolution>1</resolution>
                        <min_angle>-2.356</min_angle>
                        <max_angle>2.356</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.5</min>  <!-- 0.1 -> 0.5 (aveugle près) -->
                    <max>20.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev> <!-- 0.01 -> 0.012 (spec réelle) -->  
                </noise>
            </ray>
        </sensor>
    </gazebo>

    <!-- Capteur IMU : gyro 3 axes + accelerometre 3 axes.
         Bruit calibre type MPU9250 (valeurs generiques realistes).
         NOTE : l'IMU interne du vrai SeekurJR (paquets 0x9A) n'a jamais
         ete confirme fonctionnel (dump reel ne montrait que des SIP 0x32).
         Plan B au lab : IMU externe MPU9250 (package imu_serial_reader
         du NaviBot). L'EKF consomme /imu/data quelle que soit la source. -->
    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <pose>0 0 0 0 0 0</pose>
            <topic>imu/data</topic>
            <gz_frame_id>imu_link</gz_frame_id>
            <update_rate>100</update_rate>
            <always_on>1</always_on>
            <imu>
                <angular_velocity>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
                </angular_velocity>
                <linear_acceleration>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

    <!-- Capteur RGBD Intel RealSense D455 (simule).
         Un seul capteur rgbd_camera Gazebo Harmonic produit :
           - image RGB     (color)
           - image depth   (aligned sur RGB)
           - point cloud   (depth reprojete + couleur)
           - camera_info
         
         Spec D455 reproduites :
           - FOV RGB   90 deg horizontal (Intel : 90x65)
           - FOV depth 87 deg horizontal (Intel : 87x58) - approx via un seul
             FOV rgbd (compromis, Gazebo n'expose qu'un HFOV commun)
           - Resolution 848x480 @ 30 Hz (native RealSense, adapte YOLO/RTAB)
             REQUIERT CycloneDDS - voir commentaire sur update_rate
           - Portee depth clip 0.6 - 6.0 m (spec D455)
         
         gz_frame_id=camera_optical_frame -> les messages sortent avec le
         frame optique dans le header (RTAB-Map/YOLO/RViz OK). Le sensor
         est physiquement attache a camera_link (X pointe vers la scene),
         mais l'annotation ROS pointe vers camera_optical_frame. -->
    <gazebo reference="camera_link">
        <sensor name="camera_d455" type="rgbd_camera">
            <pose>0 0 0 0 0 0</pose>
            <topic>camera</topic>
            <gz_frame_id>camera_optical_frame</gz_frame_id>
            <!-- PREREQUIS CRITIQUE : CycloneDDS (RMW_IMPLEMENTATION=
                 rmw_cyclonedds_cpp). Avec FastDDS (defaut Jazzy), les
                 topics image/depth/pointcloud s'effondrent a 6-13 Hz avec
                 des blocages de ~1 s, quelle que soit la resolution.
                 
                 Diagnostic 2026-08, causes ECARTEES une par une :
                   - GPU        : RTX 4060 a 32% d'utilisation, large marge
                   - Gazebo     : produisait bien 14.4 Hz (mesure gz topic)
                   - RViz       : aucun effet une fois retire
                   - Resolution : reduire de 3x a EMPIRE le debit
                   - Buffers UDP noyau (rmem/wmem max) : aucun effet
                 Cause reelle : fragmentation DDS des gros messages sur
                 loopback. Une image 848x480 RGB depasse largement le seuil
                 de fragmentation ; FastDDS echoue a reconstituer, Cyclone
                 y arrive sans peine.
                 
                 Apres bascule CycloneDDS : 14.4 Hz recus pour 14.4 Hz
                 produits, ecart-type 0.006 s. Zero perte. -->
            <update_rate>30</update_rate>
            <always_on>1</always_on>
            <camera>
                <horizontal_fov>1.5708</horizontal_fov> <!-- 90 deg = pi/2 -->
                <!-- 848x480 : resolution native RealSense D455. -->
                <image>
                    <width>848</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.6</near>
                    <far>6.0</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>
        </sensor>
    </gazebo>

    <!-- Propriétés Gazebo -->
    <gazebo reference="base_link">
       <material>Gazebo/Grey</material>
    </gazebo>
    
    <gazebo reference="right_wheel_link">
        <material>Gazebo/Black</material>
    </gazebo>
    
    <gazebo reference="left_wheel_link">
        <material>Gazebo/Black</material>
    </gazebo>
    
    <gazebo reference="caster_wheel_link">
        <material>Gazebo/Black</material>
        <mu1 value="0.001" />
        <mu2 value="0.001" />
    </gazebo>

    <gazebo reference="laser_frame">
        <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="camera_link">
        <material>Gazebo/Black</material>
    </gazebo>
    
</robot>
