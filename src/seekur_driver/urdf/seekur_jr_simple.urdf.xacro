<?xml version="1.0"?>
<robot name="seekur_jr" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Argument pour la couleur -->
    <xacro:arg name="robot_color" default="Grey"/>
    <xacro:property name="robot_color" value="$(arg robot_color)"/>

    <!-- =======================================================
         Proprietes SeekurJR
         Sources :
           [DS]  Datasheet officiel Adept Rev B (2011)
           [LAB] Mesures au lab UQAT 2026-09, pneus regonfles
           [DED] Deduit par geometrie a partir de [DS] / [LAB]

         Lecture du schema dimensionnel [DS] (verifiee au lab) :
           vue de FACE : 835 = largeur hors-tout pneus
                         663 = wheel separation (centre a centre)
           vue de COTE : 1198 = longueur avec bumpers
                         1051 = longueur chassis
                          494 = hauteur totale du robot
                          425 = empattement (axe avant - axe arriere)
                                (non utilise ici : modele a 2 roues + roulette)

         ATTENTION - deux erreurs corrigees par rapport aux versions
         precedentes de ce fichier :
           - 494 etait pris pour la largeur du chassis : c'est la HAUTEUR
             totale du robot.
           - 425 etait pris pour la hauteur du chassis : c'est l'EMPATTEMENT
             longitudinal.
         La coincidence numerique entre 494 et la largeur deduite (491) avait
         masque la premiere erreur.
         ======================================================= -->

    <!-- Chassis -->
    <xacro:property name="base_length" value="1.051" />      <!-- [DS] 1051 mm (1198 mm bumpers inclus) -->
    <xacro:property name="base_width" value="0.45" />        <!-- [LAB] largeur du chassis porteur ; gap ~20 mm par cote avec le pneu -->
    <xacro:property name="base_height" value="0.381" />      <!-- [DED] hauteur totale 494 - garde au sol 113 -->
    <xacro:property name="chassis_drop" value="0.09" />      <!-- [LAB] le chassis descend sous l'axe de roue (logement moteurs) -->

    <!-- Roues : pneu marque 16 x 6.50-8 NHS -->
    <xacro:property name="wheel_radius" value="0.203" />     <!-- [DS] 16" = 406 mm diam ; confirme [LAB] apres regonflage (20 cm) -->
    <xacro:property name="wheel_length" value="0.165" />     <!-- [DS] 6.50" de section = 165 mm -->
    <xacro:property name="wheel_separation" value="0.663" /> <!-- [DS] 663 mm ; confirme [LAB] a 3 mm pres -->

    <!-- Mat de camera. Le top du chassis est a (base_height - chassis_drop)
         dans base_link, soit 0.291 m ; la camera se deduit de la hauteur du
         mat, ce qui garde les deux coherents si une dimension change. -->
    <xacro:property name="camera_mast_height" value="0.12" />  <!-- [LAB] camera 12 cm au-dessus du top du chassis -->
    <xacro:property name="camera_mast_radius" value="0.02" />  <!-- cosmetique, non mesure -->
    <xacro:property name="camera_x" value="0.376" />           <!-- [LAB] 15 cm en retrait de la bordure avant : base_length/2 - 0.15 -->
    <xacro:property name="chassis_top" value="${base_height - chassis_drop}" />

    <!-- Geometrie verticale resultante (verification) :
           axe de roue    = wheel_radius              = 0.203 m du sol
           fond chassis   = 0.203 - chassis_drop      = 0.113 m du sol
           top chassis    = 0.113 + base_height       = 0.494 m du sol  [DS] OK -->

    <!-- Masses (datasheet : robot complet 77 kg) -->
    <xacro:property name="base_mass" value="60.0" />         <!-- chassis + electronique -->
    <xacro:property name="wheel_mass" value="8.0" />         <!-- 16" pneumatique ~8 kg piece -->
    <xacro:property name="caster_mass" value="0.5" />        <!-- non present sur vrai SeekurJR, garde pour stabilite Gazebo -->

    <!-- Couleurs -->
    <material name="blue"><color rgba="0 0 0.8 1" /></material>
    <material name="grey"><color rgba="0.5 0.5 0.5 1" /></material>
    <material name="white"><color rgba="1 1 1 1" /></material>
    <material name="black"><color rgba="0.2 0.2 0.2 1"/></material>
    <material name="red"><color rgba="0.8 0 0 1"/></material>

    <material name="robot_material">
        <color rgba="0.5 0.5 0.5 1" />
    </material>

    <!-- Macros d'inertie -->
    <xacro:macro name="box_inertia" params="m x y z o_xyz o_rpy">
        <inertial>
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <mass value="${m}" />
            <inertia ixx="${(m/12) * (y*y + z*z)}" ixy="0.0" ixz="0.0"
                     iyy="${(m/12) * (x*x + z*z)}" iyz="0.0"
                     izz="${(m/12) * (x*x + y*y)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r l o_xyz o_rpy">
        <inertial>
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <mass value="${m}" />
            <inertia ixx="${(m/12) * (3*r*r + l*l)}" ixy="0.0" ixz="0.0"
                     iyy="${(m/12) * (3*r*r + l*l)}" iyz="0.0"
                     izz="${(m/2) * r*r}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="sphere_inertia" params="m r o_xyz o_rpy">
        <inertial>
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <mass value="${m}" />
            <inertia ixx="${(2/5) * m * r*r}" ixy="0.0" ixz="0.0"
                     iyy="${(2/5) * m * r*r}" iyz="0.0"
                     izz="${(2/5) * m * r*r}" />
        </inertial>
    </xacro:macro>

    <!-- Links -->
    <link name="base_footprint" />

    <!-- base_link : origine a hauteur d'AXE DE ROUE (z = wheel_radius depuis
         base_footprint), centree longitudinalement sur le chassis.
         Le chassis lui-meme descend de chassis_drop sous cette origine, d'ou
         le decalage -chassis_drop applique aux trois origines ci-dessous. -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0 - chassis_drop}" rpy="0 0 0" />
            <material name="robot_material"/>
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0 - chassis_drop}" rpy="0 0 0" />
        </collision>
        <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"
                          o_xyz="0 0 ${base_height / 2.0 - chassis_drop}" o_rpy="0 0 0" />
    </link>

    <link name="right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
        </collision>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_length}"
                               o_xyz="0 0 0" o_rpy="${pi / 2.0} 0 0" />
    </link>

    <link name="left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
        </collision>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_length}"
                               o_xyz="0 0 0" o_rpy="${pi / 2.0} 0 0" />
    </link>

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${wheel_radius / 2.0}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius / 2.0}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:sphere_inertia m="${caster_mass}" r="${wheel_radius / 2.0}"
                             o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <!-- LiDAR Link -->
    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.07" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.07" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:cylinder_inertia m="1.0" r="0.05" l="0.07"
                               o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <!-- IMU Link : monte sur la plateforme basse du chassis, sur l'axe
         vertical de rotation (voir imu_joint pour le detail du placement).
         Petit box symbolique, inertie negligeable mais non nulle (exigence Gazebo). -->
    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.03 0.03 0.02" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="red" />
        </visual>
        <xacro:box_inertia m="0.05" x="0.03" y="0.03" z="0.02"
                          o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <!-- ================================================================
         Camera RealSense D455 : montee sur mat au-dessus du chassis.
         Convention frames RealSense/ROS :
           - camera_link          : convention robot (X vers l'avant)
           - camera_optical_frame : convention optique (Z vers la scene,
                                    X droite, Y bas) - c'est ce frame_id
                                    que RTAB-Map, YOLO ROS, RViz attendent
                                    dans le header des images.
         Le sensor Gazebo est declare sur camera_link (regarde vers +X du
         link, donc vers l'avant du robot). Le gz_frame_id force le frame
         optique dans les messages ROS -> memes conventions que le vrai
         driver realsense2_camera.
         ================================================================ -->
    <!-- Mat support de la camera : simple montant vertical entre le top du
         chassis et la camera. Purement cosmetique (sans lui la camera
         flotte en l'air dans RViz et Gazebo), mais il rend le modele
         lisible d'un coup d'oeil. Visual + inertie seulement, pas de
         collision : meme convention que camera_link et imu_link. -->
    <link name="camera_mast_link">
        <visual>
            <geometry>
                <cylinder radius="${camera_mast_radius}" length="${camera_mast_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <xacro:cylinder_inertia m="0.3" r="${camera_mast_radius}" l="${camera_mast_height}"
                               o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <link name="camera_link">
        <visual>
            <!-- D455 : 124 x 26 x 29 mm approximatif (bandeau caviar) -->
            <geometry>
                <box size="0.026 0.124 0.029" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="black" />
        </visual>
        <xacro:box_inertia m="0.1" x="0.026" y="0.124" z="0.029"
                          o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <!-- Frame optique : rotation ROS -> optique. Convention standard :
         RPY = (-pi/2, 0, -pi/2) fait que Z_optique aligne avec X_link,
         X_optique aligne avec -Y_link, Y_optique aligne avec -Z_link.
         C'est LA convention utilisee par tous les drivers de camera ROS. -->
    <link name="camera_optical_frame" />

    <!-- Joints -->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <!-- Roues motrices.
         Y : depuis wheel_separation [DS] directement. NE PAS recalculer
             depuis base_width + wheel_length : le chassis a un gap de
             degagement avec le pneu, les deux grandeurs sont independantes.
         X : -base_length/4. Le vrai robot a 4 roues en skid-steer ; ce
             modele en a 2 + une roulette avant, donc l'empattement reel
             (425 mm [DS]) ne s'applique pas ici et n'est pas modelise.

         LIMITE CONNUE - centre de rotation.
         Le vrai SeekurJR pivote au milieu de son empattement (x = 0).
         Ce modele pivote autour de l'axe de ses deux roues (x = -0.263),
         donc en rotation pure il decrit un arc de 26 cm de rayon au lieu
         de tourner sur place. Biais systematique, borne, connu.
         Correction possible le jour ou une rotation reelle est disponible
         pour comparaison : roues a x = 0 + une seconde roulette a
         l'arriere pour l'equilibre. Non fait pour l'instant : ce modele
         est stable dans Gazebo et a servi de base aux jalons v6 a v9,
         toucher a l'equilibre introduirait un risque non borne pour
         corriger une erreur qui l'est. -->
    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel_link" />
        <origin xyz="${-base_length / 4.0} ${-wheel_separation / 2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel_link" />
        <origin xyz="${-base_length / 4.0} ${wheel_separation / 2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <!-- IMU monte au centre de la PLATEFORME BASSE du chassis.
         x = y = 0 : sur l'axe vertical de rotation du robot, donc aucune
           acceleration centripete parasite en rotation lacet.
         z = -chassis_drop : le fond du chassis, soit 0.113 m du sol.
           Plus bas que l'ancienne position a mi-hauteur, et donc plus
           proche du plan des axes de roue (z = 0) autour duquel se fait
           le tangage quand le robot franchit un obstacle : moins
           d'acceleration parasite injectee dans l'EKF sur terrain irregulier. -->
    <joint name="imu_joint" type="fixed">
        <parent link="base_link" />
        <child link="imu_link" />
        <origin xyz="0 0 ${-chassis_drop}" rpy="0 0 0" />
    </joint>

    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_link" />
        <origin xyz="${base_length / 3.0} 0 ${-wheel_radius / 2.0}" rpy="0 0 0" />
    </joint>

    <!-- LiDAR SICK, monte en saillie a l'AVANT sur support en equerre.
         z : [LAB] 39 cm du sol apres regonflage -> 0.39 - 0.203 = 0.187
         x : [EST] le boitier est sensiblement a l'aplomb de la bordure
             avant du chassis (base_length/2 = 0.5255). Valeur a confirmer
             au ruban : distance centre du boitier <-> bordure avant.
         y : NON MESURE. La vue de dessus montre le LiDAR decale vers la
             GAUCHE du robot (il deborde du contour bleu de ce cote), mais
             la valeur n'a pas ete relevee. Laisse a 0 volontairement :
             mettre une estimation ici propagerait une erreur silencieuse
             dans toute la carte SLAM (un decalage lateral non modelise
             biaise les distances mur gauche / mur droit).
             A MESURER : distance centre du boitier <-> axe longitudinal. -->
    <joint name="laser_joint" type="fixed">
        <parent link="base_link" />
        <child link="laser_frame" />
        <origin xyz="0.535 0 0.187" rpy="0 0 0" />
    </joint>

    <!-- Mat : pose sur le top du chassis, monte de camera_mast_height.
         Son origine est au milieu du cylindre, d'ou le /2. -->
    <joint name="camera_mast_joint" type="fixed">
        <parent link="base_link" />
        <child link="camera_mast_link" />
        <origin xyz="${camera_x} 0 ${chassis_top + camera_mast_height / 2.0}" rpy="0 0 0" />
    </joint>

    <!-- Camera RealSense D455, en haut du mat.
         x : [LAB] 15 cm en retrait de la bordure avant du chassis
             -> base_length/2 - 0.15 = 0.5255 - 0.15 = 0.376
         z : [LAB] 12 cm au-dessus du top du chassis (494 mm du sol [DS])
             -> chassis_top + camera_mast_height = 0.291 + 0.12 = 0.411
                soit 0.614 m du sol
         y : suppose centree. A confirmer d'un coup d'oeil depuis le dessus. -->
    <joint name="camera_joint" type="fixed">
        <parent link="base_link" />
        <child link="camera_link" />
        <origin xyz="${camera_x} 0 ${chassis_top + camera_mast_height}" rpy="0 0 0" />
    </joint>

    <!-- Joint optique : rotation qui aligne le repere optique standard
         (Z vers la scene) avec le repere robot (X vers la scene). -->
    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link" />
        <child link="camera_optical_frame" />
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
    </joint>

    <gazebo>
        <plugin filename="libgz-sim-diff-drive-system.so" name="gz::sim::systems::DiffDrive">
            <left_joint>base_left_wheel_joint</left_joint>
            <right_joint>base_right_wheel_joint</right_joint>
            <!-- Doivent rester coherents avec les proprietes xacro en tete
                 de fichier. Gazebo ne lit pas les ${} ici, d'ou la
                 duplication en dur des valeurs. -->
            <wheel_separation>0.663</wheel_separation>      <!-- [DS] -->
            <wheel_radius>0.203</wheel_radius>              <!-- [DS] -->

            <topic>cmd_vel</topic>
            <odom_topic>odom</odom_topic>
            <tf_topic>tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>false</publish_odom_tf>
            <!-- IMPORTANT : false. C'est robot_state_publisher qui doit
                 produire les TF des roues à partir de /joint_states.
                 Si les deux publient, RViz2 reçoit des TF en double
                 (avertissements TF_REPEATED_DATA + affichage instable). -->
            <publish_wheel_tf>false</publish_wheel_tf>
        </plugin>
    </gazebo>

    <!-- ==================================================================
         Plugin JointStatePublisher : UNE SEULE déclaration.
         C'est lui qui produit l'état (position/vitesse) des roues côté
         Gazebo. Ce flux doit ensuite être ponté vers ROS2 (/joint_states)
         par ros_gz_bridge, sinon RViz2 affiche des roues figées.
         ================================================================== -->
    <gazebo>
        <plugin filename="libgz-sim-joint-state-publisher-system.so" name="gz::sim::systems::JointStatePublisher">
            <joint_name>base_left_wheel_joint</joint_name>
            <joint_name>base_right_wheel_joint</joint_name>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
    </gazebo>

    <!-- Systeme IMU : indispensable pour que le capteur type "imu" produise
         des donnees. Distinct de gz-sim-sensors-system (qui gere lidar/camera).
         Sans ce systeme, le <sensor type="imu"> reste muet. -->
    <gazebo>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
        </plugin>
    </gazebo>

    <!-- Plugin LiDAR -->
    <gazebo reference="laser_frame">
        <sensor name="laser_scanner" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <topic>scan</topic>
            <gz_frame_id>laser_frame</gz_frame_id>
            <update_rate>25</update_rate>   <!-- 10 -> 25 (LMS111 standard) -->
            <ray>
                <scan>
                    <horizontal>
                        <samples>541</samples>  <!-- 540 -> 541 (270° / 0.5° + 1) -->
                        <resolution>1</resolution>
                        <min_angle>-2.356</min_angle>
                        <max_angle>2.356</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.5</min>  <!-- 0.1 -> 0.5 (aveugle près) -->
                    <max>20.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev> <!-- 0.01 -> 0.012 (spec réelle) -->
                </noise>
            </ray>
        </sensor>
    </gazebo>

    <!-- Capteur IMU : gyro 3 axes + accelerometre 3 axes.
         Bruit calibre type MPU9250 (valeurs generiques realistes).
         NOTE : l'IMU interne du vrai SeekurJR (paquets 0x9A) n'a jamais
         ete confirme fonctionnel (dump reel ne montrait que des SIP 0x32).
         Plan B au lab : IMU externe MPU9250 (package imu_serial_reader
         du NaviBot). L'EKF consomme /imu/data quelle que soit la source. -->
    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <pose>0 0 0 0 0 0</pose>
            <topic>imu/data</topic>
            <gz_frame_id>imu_link</gz_frame_id>
            <update_rate>100</update_rate>
            <always_on>1</always_on>
            <imu>
                <angular_velocity>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
                </angular_velocity>
                <linear_acceleration>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

    <!-- Capteur RGBD Intel RealSense D455 (simule).
         Un seul capteur rgbd_camera Gazebo Harmonic produit :
           - image RGB     (color)
           - image depth   (aligned sur RGB)
           - point cloud   (depth reprojete + couleur)
           - camera_info

         Spec D455 reproduites :
           - FOV RGB   90 deg horizontal (Intel : 90x65)
           - FOV depth 87 deg horizontal (Intel : 87x58) - approx via un seul
             FOV rgbd (compromis, Gazebo n'expose qu'un HFOV commun)
           - Resolution 848x480 @ 30 Hz (native RealSense, adapte YOLO/RTAB)
             REQUIERT CycloneDDS - voir commentaire sur update_rate
           - Portee depth clip 0.6 - 6.0 m (spec D455)

         gz_frame_id=camera_optical_frame -> les messages sortent avec le
         frame optique dans le header (RTAB-Map/YOLO/RViz OK). Le sensor
         est physiquement attache a camera_link (X pointe vers la scene),
         mais l'annotation ROS pointe vers camera_optical_frame. -->
    <gazebo reference="camera_link">
        <sensor name="camera_d455" type="rgbd_camera">
            <pose>0 0 0 0 0 0</pose>
            <topic>camera</topic>
            <gz_frame_id>camera_optical_frame</gz_frame_id>
            <!-- PREREQUIS CRITIQUE : CycloneDDS (RMW_IMPLEMENTATION=
                 rmw_cyclonedds_cpp). Avec FastDDS (defaut Jazzy), les
                 topics image/depth/pointcloud s'effondrent a 6-13 Hz avec
                 des blocages de ~1 s, quelle que soit la resolution.

                 Diagnostic 2026-08, causes ECARTEES une par une :
                   - GPU        : RTX 4060 a 32% d'utilisation, large marge
                   - Gazebo     : produisait bien 14.4 Hz (mesure gz topic)
                   - RViz       : aucun effet une fois retire
                   - Resolution : reduire de 3x a EMPIRE le debit
                   - Buffers UDP noyau (rmem/wmem max) : aucun effet
                 Cause reelle : fragmentation DDS des gros messages sur
                 loopback. Une image 848x480 RGB depasse largement le seuil
                 de fragmentation ; FastDDS echoue a reconstituer, Cyclone
                 y arrive sans peine.

                 Apres bascule CycloneDDS : 14.4 Hz recus pour 14.4 Hz
                 produits, ecart-type 0.006 s. Zero perte. -->
            <update_rate>30</update_rate>
            <always_on>1</always_on>
            <camera>
                <horizontal_fov>1.5708</horizontal_fov> <!-- 90 deg = pi/2 -->
                <!-- 848x480 : resolution native RealSense D455. -->
                <image>
                    <width>848</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.6</near>
                    <far>6.0</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>
        </sensor>
    </gazebo>

    <!-- Propriétés Gazebo -->
    <gazebo reference="base_link">
       <material>Gazebo/Grey</material>
    </gazebo>

    <gazebo reference="right_wheel_link">
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="left_wheel_link">
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="caster_wheel_link">
        <material>Gazebo/Black</material>
        <mu1 value="0.001" />
        <mu2 value="0.001" />
    </gazebo>

    <gazebo reference="laser_frame">
        <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="camera_mast_link">
        <material>Gazebo/Grey</material>
    </gazebo>

    <gazebo reference="camera_link">
        <material>Gazebo/Black</material>
    </gazebo>
</robot>
