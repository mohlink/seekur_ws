<?xml version="1.0"?>
<sdf version="1.9">
  <model name="mine_scan">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh><uri>model://mine_scan/meshes/mine.obj</uri></mesh>
        </geometry>
